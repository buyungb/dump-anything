# Copy to `.env` next to docker-compose.yml and edit as needed.
# Compose picks `.env` up automatically.

# Host-side port. Override if 8080 is busy on your machine.
APP_PORT=8080

# HTTP basic auth for the dashboard + API.
# Leave both empty to keep the app fully public.
# /health is always reachable without credentials so orchestrator probes work.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_REALM=Dump Anything

# Optional API key bootstrap. If set, this value is persisted as the first
# API key whenever the database has no active keys (handy for ops automation
# so you don't need to scrape it from the logs). Leave empty to let the
# server auto-generate one and print it on first start.
# BOOTSTRAP_API_KEY=da_replace-with-32-hex-chars
