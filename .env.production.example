# Production overrides for docker compose. Copy to `.env.production` and
# load it explicitly:
#
#     docker compose --env-file .env.production up -d
#
# `.env.production` is gitignored so its real secrets never enter the
# repository. Anything you don't set here falls back to the defaults baked
# into docker-compose.yml.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Pin to a specific tag for reproducible deploys (used by
# docker-compose.dokploy.yml). The standard docker-compose.yml hard-codes
# `:latest`; edit it manually if you need to pin there too.
APP_IMAGE_TAG=0.4.0

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Host-side port (only used by docker-compose.yml — Dokploy doesn't expose
# host ports; Traefik handles ingress instead). Behind a reverse proxy you
# usually bind to 127.0.0.1:8080 and let the proxy handle TLS + 80/443.
APP_PORT=8080

# ---------------------------------------------------------------------------
# Dashboard HTTP basic auth (defence-in-depth on top of the API key)
# ---------------------------------------------------------------------------
# Both must be set to enable basic auth. Leave empty to disable. /health and
# /docs/* always stay public so probes and shareable docs links keep working.
DASHBOARD_USER=admin

# Generate a strong password — never commit the real value.
#   openssl rand -base64 24
DASHBOARD_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD

DASHBOARD_REALM=Dump Anything

# ---------------------------------------------------------------------------
# API key bootstrap
# ---------------------------------------------------------------------------
# When the database has no active keys yet, this exact value is persisted as
# the first key — so you don't have to scrape it from container logs in CI.
# Generate one with:
#   echo "da_$(openssl rand -hex 16)"
# Comment the line out to let the server auto-generate one and log it once.
BOOTSTRAP_API_KEY=da_REPLACE_WITH_32_HEX_CHARS

# ---------------------------------------------------------------------------
# Production hardening checklist (manual steps, not env vars)
# ---------------------------------------------------------------------------
# 1. Pin the image. In docker-compose.yml change
#       image: buyungbahari/dump-anything:latest
#    to a tag you've vetted, e.g.
#       image: buyungbahari/dump-anything:0.4.0
#    so an upstream push can never silently change your prod build.
# 2. Put TLS in front of port 8080 (Caddy / Traefik / Cloudflare).
# 3. Snapshot the `dump-anything-mongo-data` volume on a schedule
#    (see "Data persistence" in README).
# 4. Restrict 27017 — the compose file maps it for convenience; remove the
#    `ports: - "27017:27017"` block from the `mongo` service if you don't
#    need direct mongosh access from the host.
