# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=dump_anything

# HTTP server
PORT=3000
HOST=0.0.0.0

# CORS: comma-separated list of allowed origins, or "*" for any
CORS_ORIGINS=http://localhost:5173

RUST_LOG=info,dump_anything_api=debug

# API key bootstrap (optional). If set, this exact value seeds the first key
# whenever the database has no active keys yet. If unset, the server generates
# a random key on first run and prints it to the logs once.
# BOOTSTRAP_API_KEY=da_replace-with-32-hex-chars
